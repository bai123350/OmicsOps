{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmicsOps",
  "version": "0.1.0",
  "identifier": "io.omicsops.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmicsOps",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../skills/single-cell/": "skills/single-cell/"
    },
    "icon": []
  }
}
