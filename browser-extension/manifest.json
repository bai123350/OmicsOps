{
  "manifest_version": 3,
  "name": "OmicsOps Browser Bridge",
  "version": "0.1.0",
  "description": "A local-only browser bridge for explicit OmicsOps research actions.",
  "key": "",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OmicsOps Browser Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:18775 ws://127.0.0.1:18776"
  }
}
